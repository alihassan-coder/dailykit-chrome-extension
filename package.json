{
	"name": "toolbelt",
	"private": true,
	"description": "Your own browser tools in one extension. Each tool also ships on its own.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @toolbelt/app-toolbelt dev",
		"dev:cairn": "pnpm --filter @toolbelt/app-cairn dev",
		"build": "pnpm -r --filter './apps/*' build",
		"build:firefox": "pnpm -r --filter './apps/*' build:firefox",
		"zip": "pnpm -r --filter './apps/*' zip",
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run",
		"format": "prettier --write .",
		"check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm size",
		"changeset": "changeset",
		"e2e": "vitest run -c vitest.e2e.config.ts",
		"format:check": "prettier --check .",
		"size": "node scripts/check-bundle.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@eslint/js": "10.0.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.14.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-boundaries": "7.4.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.13.0",
		"jsdom": "30.1.3",
		"prettier": "3.9.10",
		"puppeteer-core": "25.16.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
