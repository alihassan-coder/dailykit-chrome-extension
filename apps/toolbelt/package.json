		"@toolbelt/tool-color-picker": "workspace:*",
		"@toolbelt/tool-grayscale": "workspace:*",
		"lucide-react": "1.66.0",
		"@toolbelt/db": "workspace:*"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@toolbelt/wxt-kit": "workspace:*",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@wxt-dev/module-react": "1.2.2",
		"tailwindcss": "4.3.3",
